<?xml version="1.0" encoding="UTF-8"?>
<simconf version="2024090601">
  <simulation>
    <title>RING Leader Election - 50 Nodes - 70% Success Rate (Network Noise)</title>
    <randomseed>123456</randomseed>
    <motedelay_us>1000000</motedelay_us>
    <radiomedium>
      org.contikios.cooja.radiomediums.UDGM
      <transmitting_range>350.0</transmitting_range>
      <interference_range>350.0</interference_range>
      <success_ratio_tx>0.7</success_ratio_tx>
      <success_ratio_rx>0.7</success_ratio_rx>
    </radiomedium>
    <events>
      <logoutput>40000</logoutput>
    </events>
